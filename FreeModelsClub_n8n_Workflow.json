    {
      "parameters": {
        "jsCode": "const fetched = $input.first().json.freeModels || [];\nlet selected = fetched.filter(m => m.isFree).map(m => m.modelId);\nif (selected.length === 0) {\n  selected = ['llama-3.3-70b-versatile', 'qwen/qwen3.6-27b', 'deepseek-r1-distill-llama-70b'];\n}\nreturn [{\n  json: {\n    providerId: 'prov_groq',\n    selectedModels: selected,\n    modelCount: selected.length\n  }\n}];"
      },
      "id": "node-step3a-select",
      "name": "💾 Step 3a: Select Models to Save",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },

